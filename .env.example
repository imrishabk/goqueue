DATABASE_URL=postgres://username:password@host:port/database?sslmode=disable
COORDINATOR_URL=http://localhost:8080
WORKER_ID=worker-1
HOSTNAME=worker-1
# comma-separated job types this worker handles; empty = any
CAPABILITIES=
POLL_INTERVAL=2s
# retry backoff: first retry waits ~BASE, doubling with jitter up to CAP
BACKOFF_BASE=5s
BACKOFF_CAP=10m
